# Keep this file free of real secrets. Copy it to .env on the server.
# Set either the plaintext code or its SHA-256 hash, not both.
# This code only waives the fee for the free Basic tier's private
# complimentary-access path. Plus and Plus Plus subscriptions and donations
# are sold directly through Stripe Payment Links on members.html/support.html
# and are not configured here.
MEMBERSHIP_ACCESS_CODE=
MEMBERSHIP_ACCESS_CODE_SHA256=

# Configure verification delivery on the production server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@apotheosischurch.org
